<?xml version="1.0"?>
<package format="3">
  <name>hc_dataset</name>
  <version>0.1.0</version>
  <description>Isolated rosbag2/MCAP dataset recording, catalog and replay.</description>
  <maintainer email="robotics@hc.local">HC Robotics</maintainer>
  <license>Proprietary</license>

  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>hc_teleop_interfaces</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>rosbag2</exec_depend>
  <exec_depend>rosbag2_storage_mcap</exec_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
