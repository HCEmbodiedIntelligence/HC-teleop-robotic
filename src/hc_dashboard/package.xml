<?xml version="1.0"?>
<package format="3">
  <name>hc_dashboard</name>
  <version>0.1.0</version>
  <description>Read-only ROS telemetry and safety-service web dashboard.</description>
  <maintainer email="robotics@hc.local">HC Robotics</maintainer>
  <license>Proprietary</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>hc_teleop_interfaces</exec_depend>
  <exec_depend>python3-aiohttp</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
