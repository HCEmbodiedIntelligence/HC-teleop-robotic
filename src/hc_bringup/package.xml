  <version>0.1.0</version>
  <description>Profile validation, workspace doctor, and native ROS 2 bringup.</description>
  <maintainer email="czy33114@gmail.com">HC Teleop Team</maintainer>
  <license>Proprietary</license>

  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>hc_dashboard</exec_depend>
  <exec_depend>hc_diagnostics</exec_depend>
  <exec_depend>hc_teleop_core</exec_depend>
  <exec_depend>hc_vr_gateway</exec_depend>
  <exec_depend>hc_adapter_openarmx</exec_depend>
  <exec_depend>hc_adapter_x1</exec_depend>
  <exec_depend>hc_motion</exec_depend>
