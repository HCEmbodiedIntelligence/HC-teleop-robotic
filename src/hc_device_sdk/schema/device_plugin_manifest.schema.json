{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hc.example/schemas/device-plugin-manifest-v1.json",
  "title": "HC device plugin manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "package", "plugins"],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "package": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "plugins": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["class_name", "base_class", "component_kinds", "capabilities"],
        "properties": {
          "class_name": {
            "type": "string",
            "minLength": 1
          },
          "base_class": {
            "enum": [
              "hc_device_sdk::DevicePlugin",
              "hc_device_sdk::JointDevicePlugin"
            ]
          },
          "component_kinds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "arm",
                "gripper",
                "dexterous_hand",
                "camera",
                "waist",
                "base",
                "sensor"
              ]
            }
          },
          "capabilities": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_.-]*$"
            }
          }
        }
      }
    }
  }
}
