# Local dependency bundles and virtual environments
.deps/
.venv/
venv/

# Python caches and test artifacts
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/

# Runtime-generated diagnostics and logs
runtime/
*.log

# Editor and operating-system metadata
.vscode/
.idea/
.DS_Store
*~

# Runtime supervisor is source code, not generated session data.
!tools/runtime/
!tools/runtime/**

# User-imported robot profiles in adapters/robots/ (keep built-in profiles)
adapters/robots/*
!adapters/robots/openarmx/
!adapters/robots/x1/
!adapters/robots/.gitkeep
!adapters/robots/*.md

