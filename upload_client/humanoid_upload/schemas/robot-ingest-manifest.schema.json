{
  "$defs": {
    "CaptureMode": {
      "enum": [
        "PRESEGMENTED",
        "CONTINUOUS"
      ],
      "title": "CaptureMode",
      "type": "string"
    },
    "FpsRational": {
      "additionalProperties": false,
      "properties": {
        "denominator": {
          "exclusiveMinimum": 0,
          "maximum": 1000000,
          "title": "Denominator",
          "type": "integer"
        },
        "numerator": {
          "exclusiveMinimum": 0,
          "maximum": 1000000,
          "title": "Numerator",
          "type": "integer"
        }
      },
      "required": [
        "numerator",
        "denominator"
      ],
      "title": "FpsRational",
      "type": "object"
    },
    "RobotIngestAssetManifest": {
      "additionalProperties": false,
      "properties": {
        "asset_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._-]+$",
          "title": "Asset Id",
          "type": "string"
        },
        "camera_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9._-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Camera Id"
        },
        "crc64": {
          "pattern": "^(?:0|[1-9][0-9]*)$",
          "title": "Crc64",
          "type": "string"
        },
        "media_type": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "path": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "role": {
          "default": "RAW",
          "maxLength": 64,
          "minLength": 1,
          "title": "Role",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "exclusiveMinimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "asset_id",
        "path",
        "media_type",
        "size_bytes",
        "sha256",
        "crc64"
      ],
      "title": "RobotIngestAssetManifest",
      "type": "object"
    },
    "RobotIngestCameraManifest": {
      "additionalProperties": false,
      "properties": {
        "asset_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9._-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Asset Id"
        },
        "camera_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._-]+$",
          "title": "Camera Id",
          "type": "string"
        },
        "capture_ended_at": {
          "format": "date-time",
          "title": "Capture Ended At",
          "type": "string"
        },
        "capture_started_at": {
          "format": "date-time",
          "title": "Capture Started At",
          "type": "string"
        },
        "clock_domain": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Clock Domain",
          "type": "string"
        },
        "codec": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Codec",
          "type": "string"
        },
        "declared_duration_ns": {
          "minimum": 0,
          "title": "Declared Duration Ns",
          "type": "integer"
        },
        "declared_fps": {
          "$ref": "#/$defs/FpsRational"
        },
        "declared_frame_count": {
          "minimum": 0,
          "title": "Declared Frame Count",
          "type": "integer"
        },
        "height": {
          "exclusiveMinimum": 0,
          "maximum": 65535,
          "title": "Height",
          "type": "integer"
        },
        "path": {
          "anyOf": [
            {
              "maxLength": 1024,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        },
        "time_base": {
          "anyOf": [
            {
              "$ref": "#/$defs/FpsRational"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "width": {
          "exclusiveMinimum": 0,
          "maximum": 65535,
          "title": "Width",
          "type": "integer"
        }
      },
      "required": [
        "camera_id",
        "codec",
        "width",
        "height",
        "declared_fps",
        "declared_frame_count",
        "declared_duration_ns",
        "clock_domain",
        "capture_started_at",
        "capture_ended_at"
      ],
      "title": "RobotIngestCameraManifest",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "assets": {
      "items": {
        "$ref": "#/$defs/RobotIngestAssetManifest"
      },
      "maxItems": 4096,
      "minItems": 1,
      "title": "Assets",
      "type": "array"
    },
    "cameras": {
      "default": [],
      "items": {
        "$ref": "#/$defs/RobotIngestCameraManifest"
      },
      "maxItems": 128,
      "title": "Cameras",
      "type": "array"
    },
    "capture_ended_at": {
      "format": "date-time",
      "title": "Capture Ended At",
      "type": "string"
    },
    "capture_mode": {
      "$ref": "#/$defs/CaptureMode"
    },
    "capture_started_at": {
      "format": "date-time",
      "title": "Capture Started At",
      "type": "string"
    },
    "client_upload_id": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "title": "Client Upload Id",
      "type": "string"
    },
    "collection_job_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._-]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Collection Job Id"
    },
    "collection_task_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._-]+$",
      "title": "Collection Task Id",
      "type": "string"
    },
    "declared_episode_count": {
      "anyOf": [
        {
          "maximum": 1000000,
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Declared Episode Count"
    },
    "format_metadata": {
      "additionalProperties": true,
      "title": "Format Metadata",
      "type": "object"
    },
    "organization_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._-]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Organization Id"
    },
    "project_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._-]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Project Id"
    },
    "robot_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._-]+$",
      "title": "Robot Id",
      "type": "string"
    },
    "schema_version": {
      "const": "robot-ingest/v1",
      "default": "robot-ingest/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "source_format": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._+-]+$",
      "title": "Source Format",
      "type": "string"
    },
    "source_format_version": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Source Format Version",
      "type": "string"
    }
  },
  "required": [
    "client_upload_id",
    "collection_task_id",
    "robot_id",
    "capture_mode",
    "source_format",
    "source_format_version",
    "capture_started_at",
    "capture_ended_at",
    "assets"
  ],
  "title": "RobotIngestUploadManifest",
  "type": "object"
}
