{
  "$defs": {
    "AssetState": {
      "enum": [
        "UPLOADING",
        "COMPLETED",
        "FAILED",
        "CANCELLED"
      ],
      "title": "AssetState",
      "type": "string"
    },
    "CameraVerification": {
      "additionalProperties": false,
      "properties": {
        "camera_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._-]+$",
          "title": "Camera Id",
          "type": "string"
        },
        "continuity_status": {
          "default": "PENDING",
          "maxLength": 64,
          "minLength": 1,
          "title": "Continuity Status",
          "type": "string"
        },
        "failure_code": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Failure Code"
        },
        "synchronization_status": {
          "default": "PENDING",
          "maxLength": 64,
          "minLength": 1,
          "title": "Synchronization Status",
          "type": "string"
        },
        "validation_status": {
          "default": "PENDING",
          "maxLength": 64,
          "minLength": 1,
          "title": "Validation Status",
          "type": "string"
        },
        "verified_duration_ns": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Verified Duration Ns"
        },
        "verified_fps": {
          "anyOf": [
            {
              "$ref": "#/$defs/FpsRational"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "verified_frame_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Verified Frame Count"
        }
      },
      "required": [
        "camera_id"
      ],
      "title": "CameraVerification",
      "type": "object"
    },
    "CaptureMode": {
      "enum": [
        "PRESEGMENTED",
        "CONTINUOUS"
      ],
      "title": "CaptureMode",
      "type": "string"
    },
    "FpsRational": {
      "additionalProperties": false,
      "properties": {
        "denominator": {
          "exclusiveMinimum": 0,
          "maximum": 1000000,
          "title": "Denominator",
          "type": "integer"
        },
        "numerator": {
          "exclusiveMinimum": 0,
          "maximum": 1000000,
          "title": "Numerator",
          "type": "integer"
        }
      },
      "required": [
        "numerator",
        "denominator"
      ],
      "title": "FpsRational",
      "type": "object"
    },
    "QualityStatus": {
      "enum": [
        "PENDING",
        "PASS",
        "RISK",
        "REJECT"
      ],
      "title": "QualityStatus",
      "type": "string"
    },
    "RobotIngestAsset": {
      "additionalProperties": false,
      "properties": {
        "actual_crc64": {
          "anyOf": [
            {
              "pattern": "^(?:0|[1-9][0-9]*)$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Actual Crc64"
        },
        "actual_sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Actual Sha256"
        },
        "actual_size_bytes": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Actual Size Bytes"
        },
        "asset_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._-]+$",
          "title": "Asset Id",
          "type": "string"
        },
        "completed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Completed At"
        },
        "etag": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Etag"
        },
        "expected_crc64": {
          "pattern": "^(?:0|[1-9][0-9]*)$",
          "title": "Expected Crc64",
          "type": "string"
        },
        "expected_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Expected Sha256",
          "type": "string"
        },
        "expected_size_bytes": {
          "exclusiveMinimum": 0,
          "title": "Expected Size Bytes",
          "type": "integer"
        },
        "media_type": {
          "title": "Media Type",
          "type": "string"
        },
        "multipart_upload_id": {
          "title": "Multipart Upload Id",
          "type": "string"
        },
        "object_key": {
          "title": "Object Key",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "role": {
          "title": "Role",
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/AssetState",
          "default": "UPLOADING"
        }
      },
      "required": [
        "asset_id",
        "path",
        "role",
        "media_type",
        "object_key",
        "multipart_upload_id",
        "expected_size_bytes",
        "expected_sha256",
        "expected_crc64"
      ],
      "title": "RobotIngestAsset",
      "type": "object"
    },
    "RobotIngestAssetManifest": {
      "additionalProperties": false,
      "properties": {
        "asset_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._-]+$",
          "title": "Asset Id",
          "type": "string"
        },
        "camera_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9._-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Camera Id"
        },
        "crc64": {
          "pattern": "^(?:0|[1-9][0-9]*)$",
          "title": "Crc64",
          "type": "string"
        },
        "media_type": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "path": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "role": {
          "default": "RAW",
          "maxLength": 64,
          "minLength": 1,
          "title": "Role",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "exclusiveMinimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "asset_id",
        "path",
        "media_type",
        "size_bytes",
        "sha256",
        "crc64"
      ],
      "title": "RobotIngestAssetManifest",
      "type": "object"
    },
    "RobotIngestCameraManifest": {
      "additionalProperties": false,
      "properties": {
        "asset_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9._-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Asset Id"
        },
        "camera_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._-]+$",
          "title": "Camera Id",
          "type": "string"
        },
        "capture_ended_at": {
          "format": "date-time",
          "title": "Capture Ended At",
          "type": "string"
        },
        "capture_started_at": {
          "format": "date-time",
          "title": "Capture Started At",
          "type": "string"
        },
        "clock_domain": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Clock Domain",
          "type": "string"
        },
        "codec": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Codec",
          "type": "string"
        },
        "declared_duration_ns": {
          "minimum": 0,
          "title": "Declared Duration Ns",
          "type": "integer"
        },
        "declared_fps": {
          "$ref": "#/$defs/FpsRational"
        },
        "declared_frame_count": {
          "minimum": 0,
          "title": "Declared Frame Count",
          "type": "integer"
        },
        "height": {
          "exclusiveMinimum": 0,
          "maximum": 65535,
          "title": "Height",
          "type": "integer"
        },
        "path": {
          "anyOf": [
            {
              "maxLength": 1024,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        },
        "time_base": {
          "anyOf": [
            {
              "$ref": "#/$defs/FpsRational"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "width": {
          "exclusiveMinimum": 0,
          "maximum": 65535,
          "title": "Width",
          "type": "integer"
        }
      },
      "required": [
        "camera_id",
        "codec",
        "width",
        "height",
        "declared_fps",
        "declared_frame_count",
        "declared_duration_ns",
        "clock_domain",
        "capture_started_at",
        "capture_ended_at"
      ],
      "title": "RobotIngestCameraManifest",
      "type": "object"
    },
    "RobotIngestProcessingStatus": {
      "enum": [
        "PENDING",
        "DISCOVERING_EPISODES",
        "PROCESSING",
        "READY",
        "PARTIALLY_FAILED",
        "FAILED"
      ],
      "title": "RobotIngestProcessingStatus",
      "type": "string"
    },
    "RobotIngestUpload": {
      "additionalProperties": false,
      "properties": {
        "assets": {
          "items": {
            "$ref": "#/$defs/RobotIngestAsset"
          },
          "title": "Assets",
          "type": "array"
        },
        "authenticated_robot_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._-]+$",
          "title": "Authenticated Robot Id",
          "type": "string"
        },
        "camera_verification": {
          "default": [],
          "items": {
            "$ref": "#/$defs/CameraVerification"
          },
          "title": "Camera Verification",
          "type": "array"
        },
        "cameras": {
          "items": {
            "$ref": "#/$defs/RobotIngestCameraManifest"
          },
          "title": "Cameras",
          "type": "array"
        },
        "capture_ended_at": {
          "format": "date-time",
          "title": "Capture Ended At",
          "type": "string"
        },
        "capture_mode": {
          "$ref": "#/$defs/CaptureMode"
        },
        "capture_started_at": {
          "format": "date-time",
          "title": "Capture Started At",
          "type": "string"
        },
        "client_upload_id": {
          "title": "Client Upload Id",
          "type": "string"
        },
        "collection_job_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._-]+$",
          "title": "Collection Job Id",
          "type": "string"
        },
        "committed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Committed At"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "credential_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._-]+$",
          "title": "Credential Id",
          "type": "string"
        },
        "credential_version": {
          "minimum": 1,
          "title": "Credential Version",
          "type": "integer"
        },
        "declared_episode_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Declared Episode Count"
        },
        "derived_episode_count": {
          "default": 0,
          "minimum": 0,
          "title": "Derived Episode Count",
          "type": "integer"
        },
        "expires_at": {
          "format": "date-time",
          "title": "Expires At",
          "type": "string"
        },
        "ingest_identity_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._-]+$",
          "title": "Ingest Identity Id",
          "type": "string"
        },
        "manifest": {
          "$ref": "#/$defs/RobotIngestUploadManifest"
        },
        "manifest_fingerprint": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Manifest Fingerprint",
          "type": "string"
        },
        "processing_status": {
          "$ref": "#/$defs/RobotIngestProcessingStatus",
          "default": "PENDING"
        },
        "qc_pass_episode_count": {
          "default": 0,
          "minimum": 0,
          "title": "Qc Pass Episode Count",
          "type": "integer"
        },
        "qc_reject_episode_count": {
          "default": 0,
          "minimum": 0,
          "title": "Qc Reject Episode Count",
          "type": "integer"
        },
        "qc_risk_episode_count": {
          "default": 0,
          "minimum": 0,
          "title": "Qc Risk Episode Count",
          "type": "integer"
        },
        "quality_status": {
          "$ref": "#/$defs/QualityStatus",
          "default": "PENDING"
        },
        "raw_capture_count": {
          "default": 1,
          "minimum": 1,
          "title": "Raw Capture Count",
          "type": "integer"
        },
        "raw_source_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9._-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Raw Source Id"
        },
        "request_robot_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._-]+$",
          "title": "Request Robot Id",
          "type": "string"
        },
        "source_format": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._+-]+$",
          "title": "Source Format",
          "type": "string"
        },
        "source_format_version": {
          "title": "Source Format Version",
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/UploadState"
        },
        "target": {
          "$ref": "#/$defs/UploadTarget"
        },
        "total_bytes": {
          "exclusiveMinimum": 0,
          "title": "Total Bytes",
          "type": "integer"
        },
        "updated_at": {
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        },
        "upload_batch_count": {
          "default": 1,
          "minimum": 1,
          "title": "Upload Batch Count",
          "type": "integer"
        },
        "upload_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._-]+$",
          "title": "Upload Id",
          "type": "string"
        },
        "verified_episode_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Verified Episode Count"
        },
        "verified_frame_count": {
          "default": 0,
          "minimum": 0,
          "title": "Verified Frame Count",
          "type": "integer"
        },
        "verified_sample_count": {
          "default": 0,
          "minimum": 0,
          "title": "Verified Sample Count",
          "type": "integer"
        }
      },
      "required": [
        "upload_id",
        "client_upload_id",
        "ingest_identity_id",
        "authenticated_robot_id",
        "request_robot_id",
        "credential_id",
        "credential_version",
        "target",
        "collection_job_id",
        "capture_mode",
        "source_format",
        "source_format_version",
        "capture_started_at",
        "capture_ended_at",
        "total_bytes",
        "state",
        "manifest_fingerprint",
        "manifest",
        "assets",
        "cameras",
        "created_at",
        "expires_at",
        "updated_at"
      ],
      "title": "RobotIngestUpload",
      "type": "object"
    },
    "RobotIngestUploadManifest": {
      "additionalProperties": false,
      "properties": {
        "assets": {
          "items": {
            "$ref": "#/$defs/RobotIngestAssetManifest"
          },
          "maxItems": 4096,
          "minItems": 1,
          "title": "Assets",
          "type": "array"
        },
        "cameras": {
          "default": [],
          "items": {
            "$ref": "#/$defs/RobotIngestCameraManifest"
          },
          "maxItems": 128,
          "title": "Cameras",
          "type": "array"
        },
        "capture_ended_at": {
          "format": "date-time",
          "title": "Capture Ended At",
          "type": "string"
        },
        "capture_mode": {
          "$ref": "#/$defs/CaptureMode"
        },
        "capture_started_at": {
          "format": "date-time",
          "title": "Capture Started At",
          "type": "string"
        },
        "client_upload_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "title": "Client Upload Id",
          "type": "string"
        },
        "collection_job_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9._-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Collection Job Id"
        },
        "collection_task_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._-]+$",
          "title": "Collection Task Id",
          "type": "string"
        },
        "declared_episode_count": {
          "anyOf": [
            {
              "maximum": 1000000,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Declared Episode Count"
        },
        "format_metadata": {
          "additionalProperties": true,
          "title": "Format Metadata",
          "type": "object"
        },
        "organization_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9._-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Organization Id"
        },
        "project_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9._-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Project Id"
        },
        "robot_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._-]+$",
          "title": "Robot Id",
          "type": "string"
        },
        "schema_version": {
          "const": "robot-ingest/v1",
          "default": "robot-ingest/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "source_format": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._+-]+$",
          "title": "Source Format",
          "type": "string"
        },
        "source_format_version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Source Format Version",
          "type": "string"
        }
      },
      "required": [
        "client_upload_id",
        "collection_task_id",
        "robot_id",
        "capture_mode",
        "source_format",
        "source_format_version",
        "capture_started_at",
        "capture_ended_at",
        "assets"
      ],
      "title": "RobotIngestUploadManifest",
      "type": "object"
    },
    "UploadState": {
      "enum": [
        "UPLOADING",
        "PAUSED",
        "READY_TO_COMMIT",
        "COMMITTED",
        "FAILED",
        "CANCELLED"
      ],
      "title": "UploadState",
      "type": "string"
    },
    "UploadTarget": {
      "additionalProperties": false,
      "properties": {
        "collection_task_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._-]+$",
          "title": "Collection Task Id",
          "type": "string"
        },
        "dataset_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._-]+$",
          "title": "Dataset Id",
          "type": "string"
        },
        "organization_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._-]+$",
          "title": "Organization Id",
          "type": "string"
        },
        "processing_config": {
          "additionalProperties": true,
          "title": "Processing Config",
          "type": "object"
        },
        "project_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._-]+$",
          "title": "Project Id",
          "type": "string"
        },
        "region_code": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._-]+$",
          "title": "Region Code",
          "type": "string"
        },
        "task_status": {
          "enum": [
            "ACTIVE",
            "CLOSED",
            "CANCELLED"
          ],
          "title": "Task Status",
          "type": "string"
        }
      },
      "required": [
        "collection_task_id",
