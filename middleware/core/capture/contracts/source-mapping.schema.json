        "type": "object"
      },
      "type": "object"
    },
    "clock_epoch": {
      "minimum": 0,
      "type": "integer"
    },
    "episode_index": {
      "minimum": 0,
      "type": "integer"
    },
    "frame_index": {
      "minimum": 0,
      "type": "integer"
    },
    "receive_ns": {
      "minimum": 0,
      "type": "integer"
    },
    "session_id": {
      "minLength": 1,
      "type": "string"
    },
    "source_episode_id": {
      "minLength": 1,
      "type": "string"
    },
    "source_frame": {
      "minimum": 0,
      "type": "integer"
    },
    "state_brackets_ns": {
      "items": {
