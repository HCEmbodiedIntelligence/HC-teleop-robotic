    "action_valid": {
      "items": {
        "type": "boolean"
      },
      "minItems": 1,
      "type": "array"
    },
    "cameras": {
      "additionalProperties": {
        "additionalProperties": false,
        "properties": {
          "capture_ns": {
            "minimum": 0,
            "type": "integer"
          },
          "pts": {
            "minimum": 0,
            "type": "integer"
          },
          "receive_ns": {
            "minimum": 0,
            "type": "integer"
          },
          "source_frame": {
            "minimum": 0,
            "type": "integer"
          },
          "time_base": {
            "const": [
              1,
              30
            ]
          }
        },
