+<?xml version="1.0" encoding="UTF-8"?>
+<!-- Camera bridge processes only: never use this as a global ROS profile. -->
+<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
+  <transport_descriptors>
+    <transport_descriptor>
+      <transport_id>camera_shm</transport_id>
+      <type>SHM</type>
+      <segment_size>134217728</segment_size>
+    </transport_descriptor>
+    <transport_descriptor>
+      <transport_id>camera_udp</transport_id>
+      <type>UDPv4</type>
+      <sendBufferSize>16777216</sendBufferSize>
+      <receiveBufferSize>16777216</receiveBufferSize>
+      <interfaceWhiteList>
+        <address>192.168.0.5</address>
+        <address>192.168.2.33</address>
+      </interfaceWhiteList>
+    </transport_descriptor>
+  </transport_descriptors>
+  <participant profile_name="camera_bridge_participant" is_default_profile="true">
+    <rtps>
+      <userTransports>
+        <transport_id>camera_shm</transport_id>
+        <transport_id>camera_udp</transport_id>
+      </userTransports>
+      <useBuiltinTransports>false</useBuiltinTransports>
+    </rtps>
+  </participant>
+</profiles>
